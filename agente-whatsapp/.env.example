# Copie este archivo como .env y complete los valores. Nunca suba .env al repositorio.

# --- Servicio ---------------------------------------------------------------
# prueba: nada se envía a clientes reales (solo a NUMEROS_PRUEBA).
# produccion: el agente responde a todos. Exige credenciales completas.
MODO=prueba
PUERTO=3000
HOST=127.0.0.1
DIR_DATOS=data
ZONA_HORARIA=America/Santiago
URL_PUBLICA=

# --- Panel de administración -------------------------------------------------
ADMIN_USUARIO=patricio
# Genere el valor con: npm run clave
ADMIN_CLAVE_HASH=
# En producción (detrás de HTTPS) debe quedar en true.
COOKIE_SEGURA=false
SESION_HORAS=12
# true solo si hay un proxy HTTPS (Caddy/Nginx) delante; docker-compose ya lo activa.
CONFIAR_PROXY=false

# --- WhatsApp Business Platform (Cloud API de Meta) ---------------------------
# Se obtienen en la app de Meta for Developers (producto WhatsApp).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Texto que usted inventa y pega también en la configuración del webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
# En MODO=prueba solo estos números reciben mensajes reales (código de país, sin +).
NUMEROS_PRUEBA=
MAX_MB_ARCHIVO=16

# --- Proveedor de IA ----------------------------------------------------------
# simulado: reglas fijas, sin costo, solo para revisar el sistema.
# anthropic: Claude mediante la API de Anthropic.
IA_PROVEEDOR=simulado
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
IA_ESFUERZO=medium
IA_FALLBACKS=true
IA_CONTEXTO_COMO_SISTEMA=true
IA_MAX_ITERACIONES=6
IA_TIMEOUT_MS=90000

# --- Comportamiento del agente ------------------------------------------------
DEBOUNCE_MS=3000
HISTORIAL_MENSAJES=30
MEMORIA_SESION_HORAS=72
VERIFICACION_HORAS=12
INTENTOS_VERIFICACION=3
INTENTOS_POR_CLIENTE=5
BLOQUEO_MINUTOS=30
AVISO_FALLO_MINUTOS=30
MAX_TURNOS_HORA=30

# --- Avisos a Patricio por WhatsApp (opcional) --------------------------------
# Requiere una plantilla aprobada por Meta con dos variables: tipo y número de alerta.
NUMERO_PATRICIO=
PLANTILLA_ALERTA=
IDIOMA_PLANTILLA=es
